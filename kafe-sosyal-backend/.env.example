# Kopyala: cp .env.example .env  (gerçek değerleri üret, .env'yi asla commit'leme)
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://kafe:kafe@localhost:5432/kafe
# Boş bırakılırsa geliştirmede bellek içi depo kullanılır; production'da zorunludur.
REDIS_URL=redis://localhost:6379

# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_SECRET=gelistirme-icin-en-az-32-karakterlik-gizli-anahtar
# Telefon/OTP HMAC anahtarı. Üretmek için: openssl rand -base64 32
PHONE_PEPPER=gelistirme-icin-telefon-hmac-anahtari-degistir
# 32 bayt, base64. Üretmek için: openssl rand -base64 32
DATA_ENC_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# İsteğe bağlı ayarlar (varsayılanlar)
# ACCESS_TTL_SEC=900
# REFRESH_TTL_DAYS=30
# QR_WINDOW_SECONDS=300
# CHECKIN_HOURS=3            # veritabanı kısıtı nedeniyle en fazla 3
# LIKE_LIMIT_PER_CHECKIN=15
# MIN_AGE=18
# APP_TIMEZONE=Europe/Istanbul

# Yerel fotoğraf klasörü (production'da nesne depolamaya geçilmeli)
# UPLOAD_DIR=./uploads

# Geliştirmede false: fotoğrafsız da görünür olunabilir. Production varsayılanı true.
# REQUIRE_APPROVED_PHOTO=false
